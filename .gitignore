# Data (never commit raw/processed dataset artifacts) -- top-level only,
# so src/triagebench/data/ (source code) is not affected.
/data/
*.csv
!tests/fixtures/**/*.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.uv/
.python-version
build/
dist/

# Env / secrets
.env
.env.*
!.env.example

# Models / checkpoints / large artifacts
checkpoints/
*.pt
*.bin
*.safetensors
*.gguf
outputs/

# Reports that are large binary (keep JSON/CSV small results and plots, ignore big dumps)
reports/results/*.parquet

# OS / editor
.DS_Store
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# Test / cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
