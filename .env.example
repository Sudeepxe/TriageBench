# Copy to .env and fill in. Never commit .env.
# Frontier reference arm (Arm 5) — NOT EVALUATED in v1.0.0 (no credentials; $0 budget).
# Left here only as the documented hook for a future run.
FRONTIER_PROVIDER=anthropic          # anthropic | openai | other
FRONTIER_API_KEY=
