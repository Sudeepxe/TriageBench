# Copy to .env and fill in. Never commit .env.
# Frontier reference arm (Arm 5) — provider is configurable, not hardcoded.
FRONTIER_PROVIDER=anthropic          # anthropic | openai | other
FRONTIER_API_KEY=
FRONTIER_MODEL=                      # e.g. claude-sonnet-5, gpt-5

# Optional: HuggingFace Hub token, only needed for gated model weights
HF_TOKEN=

# Optional: cloud GPU provider credentials (only needed for Arm 4 LoRA training
# if Apple Silicon/MPS is insufficient). Fill in only the one you use.
CLOUD_GPU_PROVIDER=                  # lambda | runpod | vast | other
CLOUD_GPU_API_KEY=
